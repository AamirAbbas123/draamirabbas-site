---
import '@fontsource-variable/source-serif-4';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '@fontsource/atkinson-hyperlegible/400-italic.css';
import '../styles/global.css';
import { getSettings } from '../lib/content';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;
const s = await getSettings();
const fullName = `${s.honorific ? s.honorific + ' ' : ''}${s.name}`;
const pageTitle = title ? `${title} | ${fullName}` : `${fullName}, ${s.headline?.split('.')[0] ?? ''}`.replace(/, $/, '');
const desc = description || s.intro || s.headline || '';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/about', label: 'About' },
  { href: '/work', label: 'Work' },
  { href: '/research', label: 'Research' },
  { href: '/writing', label: 'Writing' },
  { href: '/videos', label: 'Videos' },
  { href: '/community', label: 'Community' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];

const links = s.links ?? {};
const sameAs = Object.values(links).filter(Boolean);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: s.name,
  honorificPrefix: s.honorific || undefined,
  jobTitle: 'Director, Data and Digital',
  worksFor: { '@type': 'Organization', name: 'Vital Pakistan Trust' },
  alumniOf: ['Carnegie Mellon University', 'Aga Khan University', 'Khyber Medical College'].map((n) => ({ '@type': 'CollegeOrUniversity', name: n })),
  address: { '@type': 'PostalAddress', addressLocality: 'Karachi', addressCountry: 'PK' },
  email: s.email || undefined,
  image: s.photo ? new URL(s.photo, Astro.site).href : undefined,
  url: Astro.site?.href,
  sameAs,
};
const ogImage = s.photo ? new URL(s.photo, Astro.site).href : undefined;
const footerLinks = [
  ['LinkedIn', links.linkedin], ['Substack', links.substack], ['YouTube', links.youtubeEn],
  ['YouTube Urdu', links.youtubeUr], ['GitHub', links.github], ['ORCID', links.orcid],
  ['Google Scholar', links.scholar], ['X', links.x],
].filter(([, u]) => u) as [string, string][];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{fullName}</a>
        <nav class="nav" aria-label="Main" data-open="false">
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list">Menu</button>
          <ul id="nav-list">
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <div>{fullName}, {s.location}</div>
          {s.email && <a href={`mailto:${s.email}`}>{s.email}</a>}
        </div>
        <ul>
          <li><a href="/linkedin-challenge">1065-day challenge</a></li>
          <li><a href="/speaking">Talks</a></li>
          {footerLinks.map(([label, url]) => <li><a href={url} rel="me noopener">{label}</a></li>)}
        </ul>
      </div>
    </footer>
    <script>
      const nav = document.querySelector('.nav');
      const btn = nav?.querySelector('.nav-toggle');
      btn?.addEventListener('click', () => {
        const open = nav!.getAttribute('data-open') !== 'true';
        nav!.setAttribute('data-open', String(open));
        btn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.getAttribute('data-open') === 'true') {
          nav.setAttribute('data-open', 'false');
          btn?.setAttribute('aria-expanded', 'false');
          (btn as HTMLElement)?.focus();
        }
      });
    </script>
  </body>
</html>
