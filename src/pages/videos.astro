---
import Base from '../layouts/Base.astro';
import { getSettings, getFeatured, formatDate } from '../lib/content';
import { getYoutubeVideos } from '../lib/feeds';
const [s, featured] = await Promise.all([getSettings(), getFeatured()]);
const [en, ur] = await Promise.all([
  getYoutubeVideos(s.feeds?.youtubeEnChannelId, 12),
  getYoutubeVideos(s.feeds?.youtubeUrChannelId, 12),
]);
const channels = [
  { key: 'en', name: 'English', url: s.links?.youtubeEn, subs: s.stats?.youtubeEnSubscribers, videos: en,
    pinned: featured.filter((f) => f.entry.platform === 'youtube-en') },
  { key: 'ur', name: 'Urdu', url: s.links?.youtubeUr, subs: s.stats?.youtubeUrSubscribers, videos: ur,
    pinned: featured.filter((f) => f.entry.platform === 'youtube-ur') },
].filter((c) => c.url || c.videos.length || c.pinned.length);
---
<Base title="Videos" description="Teaching epidemiology, data analysis and health AI on YouTube in English and Urdu.">
  <header class="page-head">
    <h1>Videos</h1>
    <p>Teaching epidemiology, data analysis and health AI in English and Urdu.</p>
  </header>

  {channels.length > 1 && (
    <div class="tabs" role="tablist" aria-label="Channel">
      {channels.map((c, i) => (
        <button role="tab" id={`tab-${c.key}`} aria-controls={`panel-${c.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          {c.name}
        </button>
      ))}
    </div>
  )}

  {channels.map((c, i) => (
    <section class="channel" role={channels.length > 1 ? 'tabpanel' : undefined} id={`panel-${c.key}`} aria-labelledby={channels.length > 1 ? `tab-${c.key}` : undefined} hidden={i !== 0}>
      <div class="channel-head">
        <h2>{c.name} channel</h2>
        {c.subs && <span class="muted">{c.subs} subscribers</span>}
        {c.url && <a class="button quiet" href={c.url}>Open on YouTube</a>}
      </div>
      {c.pinned.length > 0 && (
        <ul class="entries pinned">
          {c.pinned.map(({ entry: f }) => (
            <li class="entry">
              <p class="entry-title"><a href={f.url ?? '#'}>{f.title}</a></p>
              {f.summary && <p>{f.summary}</p>}
            </li>
          ))}
        </ul>
      )}
      {c.videos.length > 0 ? (
        <ul class="grid">
          {c.videos.map((v) => (
            <li>
              <a href={v.url} class="video">
                <img src={v.thumbnail} alt="" width="320" height="180" loading="lazy" />
                <span class="video-title">{v.title}</span>
              </a>
              <span class="entry-meta">{formatDate(v.date)}</span>
            </li>
          ))}
        </ul>
      ) : (
        c.pinned.length === 0 && <p class="empty">New videos appear here as they are published. {c.url && <a href={c.url}>Watch on YouTube</a>}</p>
      )}
    </section>
  ))}
  {channels.length === 0 && <p class="empty">Videos are on their way.</p>}
</Base>
<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; select(n); n.focus(); }
    });
  });
</script>
<style>
  .tabs { display: flex; gap: 0.25rem; border-bottom: 1px solid var(--rule); margin-bottom: 2rem; }
  .tabs button { font: inherit; background: none; border: 0; border-bottom: 3px solid transparent; padding: 0.6rem 1rem; color: var(--muted); cursor: pointer; }
  .tabs button[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--accent); font-weight: 700; }
  .channel-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.75rem 1.25rem; margin-bottom: 1.5rem; }
  .channel-head h2 { margin: 0; }
  .pinned { margin-bottom: 2rem; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .video { color: var(--ink); text-decoration: none; display: block; }
  .video img { border-radius: 6px; aspect-ratio: 16 / 9; object-fit: cover; width: 100%; margin-bottom: 0.6rem; }
  .video-title { display: block; font-weight: 700; line-height: 1.35; margin-bottom: 0.25rem; }
  .video:hover .video-title { color: var(--accent); text-decoration: underline; }
</style>
